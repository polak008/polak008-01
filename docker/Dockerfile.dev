# Development Dockerfile for Portfolio
# Used for local development with hot module replacement (HMR)

FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy entire project
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run development server with host flag to allow external connections
CMD ["npm", "run", "dev", "--", "--host"]
